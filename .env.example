# SentryFlow Configuration
# Copy to .env and modify as needed

# Database
DATABASE_URL=sqlite:///./sentryflow.db

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_HOURS=24

# WebSocket ticket lifetime (seconds)
WS_TICKET_LIFETIME_SECONDS=30

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Cryptography
PQC_MODE=optional
# PQC_MODE=required  # Refuse to sign without PQC
# PQC_MODE=disabled  # Ed25519 only

# HMAC key for bank-account fingerprints (hex-encoded, 32 bytes)
BANK_FINGERPRINT_KEY=CHANGE_ME_TO_RANDOM_HEX_64_CHARS

# AES-256-GCM key for field encryption (hex-encoded, 32 bytes)
FIELD_ENCRYPTION_KEY=CHANGE_ME_TO_RANDOM_HEX_64_CHARS

# Policy
DEFAULT_POLICY_FILE=data/policies/default.yaml

# Logging
LOG_LEVEL=INFO

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
